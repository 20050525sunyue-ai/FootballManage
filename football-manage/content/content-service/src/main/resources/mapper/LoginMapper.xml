<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sky.content.mapper.LoginMapper">
    <insert id="register">
            insert into sys_user (username, password,name, phone) values (#{username}, #{password},#{name},#{phone})
    </insert>

    <select id="selectUserInfo" resultType="com.sky.content.model.po.SysUser">
            select * from sys_user where username = #{username}
    </select>
</mapper>
